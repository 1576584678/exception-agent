# ===== 服务 =====
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ===== JWT（生产必须替换为强随机值，长度 >= 32）=====
JWT_SECRET=change-me-dev-secret-please-replace-32chars
JWT_EXPIRES_IN=3600

# ===== 模型策略 =====
# local  = 禁用外部模型调用（仅本地/ stub），满足 PRD FR-36 仅本地模型开关
# external = 调用外部 LLM（需配置下方 base url / key，可指向私有化网关）
MODEL_POLICY=local

# 外部 LLM（仅 MODEL_POLICY=external 时使用；私有化网关通常也是 OpenAI 兼容）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== 存储 =====
# memory = 内置内存仓储（开发期默认，重启清空，符合 MVP 骨架）
# pg     = 后续接入 PostgreSQL（需补充 pg 驱动与迁移，业务层零改动）
STORAGE=memory

# ===== 代码仓库访问 =====
# GitLab 只读 token（scope: read_api / read_repository）；也可登录后在「配置」页保存
GITLAB_TOKEN=
# GitHub PAT（repo 只读）；配置 github.com 仓库时使用
GITHUB_TOKEN=
